{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install dependencies",
      "type": "npm",
      "script": "install",
      "problemMatcher": []
    },
    {
      "label": "Dev server",
      "type": "npm",
      "script": "dev",
      "dependsOn": "Install dependencies",
      "isBackground": true,
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^$" },
        "background": { "activelyMatches": true, "beginsPattern": "VITE", "endsPattern": "Local:" }
      }
    }
  ]
}
